  - {fileID: -1403064963, guid: a1db3f6c7a50e724bbb1b93b1d989555, type: 3}
  - {fileID: 147722099, guid: 8104d9d7fc8b43c40bca587485384270, type: 3}
  - {fileID: -1394484807, guid: d109aaf74ce4e8c44b9bb7212824fd78, type: 3}
  - {fileID: 770812795, guid: 45e374dbd5438544ab4044cb8956df30, type: 3}
  - {fileID: -176103077, guid: 48abccc214fd12046afd788955eb5ace, type: 3}
  - {fileID: -1728442653, guid: f53c1c8216fb3db46bca69c2951d7cd9, type: 3}
  - {fileID: -1791767112, guid: ab4685700d249354d9e80bbb4f361789, type: 3}
  - {fileID: 2012013469, guid: ebcbcfa0ff2fa7a468b8f00b7b92e494, type: 3}
  storyScripts:
  - "\"2026\uB144, \uC720\uB09C\uD788\uB3C4 \uBB34\uB354\uC6E0\uB358 \uC5B4\uB290
    8\uC6D4\uC758 \uC5B4\uB290\uB0A0...\""
  - "\"\uC18C\uB140 \uC568\uB9AC\uC2A4\uB294 \uC3DF\uC544\uC9C0\uB294 \uD587\uC0B4
    \uC544\uB798, \uCE5C\uAD6C\uB4E4\uACFC \uB208\uBD80\uC2E0 \uBB3C\uB180\uC774\uB97C
    \uC990\uAE30\uACE0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.\""
  - "\"\uC990\uAC70\uC6C0\uB3C4 \uC7A0\uC2DC, \uC18C\uC911\uD588\uB358 \uBB3C\uCD1D\uC774
    \uD5C8\uBB34\uD558\uAC8C \uBD80\uC11C\uC838 \uBC84\uB9AC\uACE0 \uB9D9\uB2C8\uB2E4.\""
  - "\"\uB099\uB2F4\uD55C \uC568\uB9AC\uC2A4 \uC55E\uC5D0 \uC815\uCCB4\uBD88\uBA85\uC758
    \uAD11\uB300\uAC00 \uB098\uD0C0\uB098 \uAE30\uC774\uD55C \uBE5B\uAE54\uC758 \uBB3C\uCD1D\uB4E4\uC744
    \uB0B4\uBCF4\uC785\uB2C8\uB2E4.\""
  - "\"\uD640\uB9B0 \uB4EF \uAC00\uC7A5 \uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uBB3C\uCD1D\uC744
    \uACE0\uB978 \uC568\uB9AC\uC2A4\"\n"
  - "\"\uB2E4\uC2DC \uCC3E\uC740 \uD589\uBCF5\uC5D0 \uC6C3\uC74C \uC9D3\uB294 \uADF8\uB140\uC758
    \uB4A4\uB85C, \uAD11\uB300\uB294 \uC758\uBBF8\uC2EC\uC7A5\uD55C \uBBF8\uC18C\uB97C
    \uB0A8\uAE34 \uCC44 \uC0AC\uB77C\uC9D1\uB2C8\uB2E4.\""
  - "\"\uC0C8\uB85C\uC6B4 \uC7A5\uB09C\uAC10\uC774 \uBAB9\uC2DC \uB9C8\uC74C\uC5D0
    \uB4E4\uC5C8\uB358 \uC568\uB9AC\uC2A4\uB294\n\uC124\uB808\uB294 \uB9C8\uC74C\uC744
    \uC548\uACE0 \uC9D1\uC73C\uB85C \uBC1C\uAC78\uC74C\uC744 \uC62E\uAE41\uB2C8\uB2E4.\""
  - "\"\uADF8\uB0A0 \uBC24, \uC568\uB9AC\uC2A4\uB294 \uC660\uC9C0 \uBAA8\uB97C \uC774\uB04C\uB9BC\uC5D0\r\n\uC0C8
    \uBB3C\uCD1D\uC744 \uBCF4\uBB3C\uCC98\uB7FC \uACC1\uC5D0 \uB454 \uCC44 \uAE4A\uC740
    \uC7A0\uC5D0 \uBE60\uC838\uB4ED\uB2C8\uB2E4.\""
  - "\"\uADF8\uB9AC\uACE0 \uB208\uC744 \uB5B4\uC744 \uB54C\u2014\r\n\uADF8\uB140\uB294
    \uBB3C\uCD1D\uC744 \uC190\uC5D0 \uC954 \uCC44, \uACB0\uCF54 \uAE68\uC5B4\uB0A0
    \uC218 \uC5C6\uB294 \uAE30\uBB18\uD55C \uAFC8\uC758 \uC138\uACC4\uC5D0 \uAC07\uD600\uBC84\uB838\uC2B5\uB2C8\uB2E4.\""
  crossFadeDuration: 2
  slideDurations:
